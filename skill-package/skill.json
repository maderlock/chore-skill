{
  "manifest": {
    "manifestVersion": "1.0",
    "publishingInformation": {
      "locales": {
        "en-GB": {
          "name": "Daily Chores",
          "summary": "A chore timer, 1 to 120 minutes, with spoken countdown reminders.",
          "description": "Starts a chore session of the length you choose and announces how much time is left at regular intervals, so music can keep playing while you work.",
          "examplePhrases": [
            "Alexa, open daily chores",
            "Alexa, tell daily chores to start for ten minutes",
            "Alexa, ask daily chores how much time is left"
          ],
          "keywords": [
            "chores",
            "timer",
            "countdown"
          ]
        }
      },
      "isAvailableWorldwide": false,
      "distributionCountries": [
        "GB"
      ],
      "testingInstructions": "Personal development skill.",
      "category": "ORGANIZERS_AND_ASSISTANTS"
    },
    "apis": {
      "custom": {
        "endpoint": {
          "uri": "__LAMBDA_ARN__"
        },
        "interfaces": []
      }
    },
    "permissions": [
      {
        "name": "alexa::alerts:timers:skill:readwrite"
      }
    ],
    "privacyAndCompliance": {
      "allowsPurchases": false,
      "usesPersonalInfo": false,
      "isChildDirected": false,
      "isExportCompliant": true,
      "containsAds": false
    }
  }
}
