# Copy to .env and fill in. .env is gitignored; never commit it.
# Plain KEY=value lines (no quotes, no `export`) so make can include them.

# AWS SSO profile used for SAM / CloudFormation
AWS_PROFILE=

# eu-west-1 is the Lambda region Alexa uses for its Europe endpoint
AWS_REGION=eu-west-1

# ASK CLI profile created by `npx ask configure`
ASK_PROFILE=default

# Alexa Developer Console -> Build -> Endpoint -> "Your Skill ID"
SKILL_ID=
